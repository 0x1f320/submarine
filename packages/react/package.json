{
	"name": "@submarine/react",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"dev": "tsdown --watch"
	},
	"dependencies": {
		"socket.io-client": "^4.8.3"
	},
	"devDependencies": {
		"@submarine/types": "workspace:*",
		"@submarine/typescript-config": "workspace:*",
		"@types/react": "^19.1.8",
		"bippy": "^0.5.37",
		"tsdown": "^0.21.7",
		"typescript": "~5.8.3"
	},
	"peerDependencies": {
		"react": "^19.1.0"
	}
}
